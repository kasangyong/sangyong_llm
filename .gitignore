# 가상환경 — 플랫폼과 CUDA 버전에 종속되므로 절대 공유하면 안 된다.
# 서버에서는 그쪽 CUDA에 맞는 torch를 새로 설치해야 한다.
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# 원본 샤드 12GB. codeparrot-clean에서 다시 받는 편이 업로드보다 빠르다.
#   python data/download.py --shards 54
data/raw/

# 필터·토큰화 산출물 35GB+. data/prepare.py로 재생성한다.
data/processed/

# 체크포인트는 개당 612MB. 학습 결과물이라 git에 넣을 것이 아니다.
# 필요하면 릴리스나 별도 저장소로 옮길 것.
checkpoints/*
!checkpoints/.gitkeep

# 실행 로그
*.log
eval/results*.json

# 단 본 평가 결과는 남긴다. README의 문제별 표와 평가 격자 그림이 이 파일에서
# 나오는데, 다시 만들려면 3.4GB 체크포인트가 있어야 해서 받는 쪽이 재현할 수
# 없다. 1.9KB다.
!eval/results.json

# 학습 기록은 예외로 둔다. 셋 합쳐 273KB이고, 이 저장소에서 "무슨 일이
# 있었는지"를 되짚을 수 있는 유일한 증거다. 체크포인트와 달리 다시 만들 수
# 없다 — 학습을 처음부터 다시 돌려야 나온다.
!checkpoints/trainlog.jsonl
!checkpoints/RESULT.txt
!checkpoints/train_stdout.log
!checkpoints/watchdog.log

# tokenizer.json은 무시하지 않는다. 어휘 16,384가 모델 임베딩 크기와
# 묶여 있어서, 다른 기계에서 다시 학습하면 체크포인트가 호환되지 않는다.
# finetune/data/*.jsonl도 올린다(2MB). 코퍼스 없이 SFT를 바로 시험할 수 있다.

# 주피터가 편집 중인 파일을 통째로 복사해 두는 자리. README를 열어보면
# README-checkpoint.md가 생기는데, 본문과 내용이 겹치는 자동 저장본이라
# 커밋하면 같은 문서가 두 벌이 된다.
.ipynb_checkpoints/
